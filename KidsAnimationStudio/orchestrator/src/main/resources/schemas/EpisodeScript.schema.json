{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EpisodeScript",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Título cálido y atractivo del episodio para niños"
    },
    "learningObjective": {
      "type": "string",
      "description": "Objetivo didáctico específico"
    },
    "scenes": {
      "type": "array",
      "description": "Secuencia ordenada de escenas pedagógicas (entre 4 y 8 escenas)",
      "items": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": ["INTRO", "CONCEPT", "EXAMPLE", "CHALLENGE", "RECAP", "OUTRO"]
          },
          "location": {
            "type": "string",
            "description": "Nombre de la locación existente en la serie"
          },
          "bgmMood": {
            "type": "string",
            "description": "Mood musical infantil: playful, calm, curious"
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string",
                  "description": "NARRATOR o nombre del personaje que habla"
                },
                "character": {
                  "type": "string",
                  "description": "Nombre del personaje que aparece en pantalla o vacío/null"
                },
                "narration": {
                  "type": "string",
                  "description": "Oración breve en español para niños (máximo 14 palabras)"
                },
                "visualPrompt": {
                  "type": "string",
                  "description": "Descripción visual de la escena (en inglés o español) sin números dibujados"
                },
                "actionPrompt": {
                  "type": "string",
                  "description": "Movimiento simple y suave para animación I2V"
                },
                "cameraMotion": {
                  "type": "string",
                  "enum": ["STATIC", "SLOW_ZOOM_IN", "SLOW_ZOOM_OUT", "PAN_LEFT", "PAN_RIGHT"]
                },
                "continuityMode": {
                  "type": "string",
                  "enum": ["NEW_KEYFRAME", "CHAIN_LAST_FRAME"]
                },
                "overlays": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string" },
                      "value": { "type": "string" },
                      "position": { "type": "string" },
                      "appearAtWord": { "type": "string" }
                    },
                    "required": ["type", "value"]
                  }
                },
                "sfx": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "pauseAfterMs": {
                  "type": "integer",
                  "description": "Pausa en milisegundos tras la narración (300 ms por defecto, 2000 ms en preguntas)"
                }
              },
              "required": ["speaker", "narration", "visualPrompt", "cameraMotion", "continuityMode"]
            }
          }
        },
        "required": ["purpose", "location", "shots"]
      }
    }
  },
  "required": ["title", "learningObjective", "scenes"]
}
