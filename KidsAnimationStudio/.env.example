# ============================================================
# KidsAnimationStudio - Variables de entorno de ejemplo
# Copiar como .env y completar valores reales
# ============================================================

# --- Servidor ---
PORT=8082
API_KEY=
LOG_LEVEL=INFO

# --- Base de datos (contenedor propio kids-postgres) ---
DATABASE_URL=jdbc:postgresql://localhost:5434/kidsdb
DATABASE_USERNAME=kids_user
DATABASE_PASSWORD=cambiar_por_password_seguro

# --- LLM ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GEMINI_API_KEY=

# --- AI Gateway y motores ---
AI_GATEWAY_URL=http://127.0.0.1:8090
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_OUTPUT_DIR=C:/ComfyUI_NV/ComfyUI/output
GPU_MIN_FREE_MB=9000
GPU_WAIT_TIMEOUT_MIN=30

# --- Modelos ---
VIDEO_MODEL=LTX
TTS_ENGINE=kokoro
TTS_DEFAULT_VOICE=ef_dora
TTS_DEFAULT_RATE=-12%
WHISPER_MODEL=small
CHARACTER_SIMILARITY_MIN=0.80
MAX_KEYFRAME_RETRIES=3

# --- Rutas ---
STORAGE_PATH=./storage
EXPORT_PATH=./export_videos
AUDIO_LIBRARY_PATH=./audio
FFMPEG_ENCODER=h264_nvenc
