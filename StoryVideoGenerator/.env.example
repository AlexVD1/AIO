# ============================================================
# story-video-api — Variables de Entorno de Ejemplo
# Copiar este archivo como .env y completar los valores reales
# ============================================================

# --- Base de Datos PostgreSQL ---
# En Podman: jdbc:postgresql://postgres:5432/storydb
# En Local (Host): jdbc:postgresql://localhost:5433/storydb
DATABASE_URL=jdbc:postgresql://postgres:5432/storydb
DATABASE_USERNAME=story_user
DATABASE_PASSWORD=tu_password_seguro

# --- Inteligencia Artificial — Google Gemini ---
# Para generación de guiones, desglose de escenas y embeddings
AI_API_KEY=tu_gemini_api_key_aqui
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=120

# --- Generación de Imágenes — Stable Diffusion Local (GPU RTX 5070) ---
# SD WebUI Forge corriendo en host Windows (puerto 7860)
# Dentro del contenedor Podman: http://host.containers.internal:7860
# Directo en Windows (local sin contenedor): http://localhost:7860
SD_API_URL=http://host.containers.internal:7860
SD_MODEL=juggernautXL_ragnarok
IMAGE_PROVIDER=stable-diffusion-local
SD_STEPS=25
SD_CFG_SCALE=7.0
SD_WIDTH=768
SD_HEIGHT=1344

# --- Almacenamiento y Exportación ---
STORAGE_PATH=/data/storage
STORAGE_BASE_URL=http://localhost:8081/assets
EXPORT_PATH=/export_videos

# --- Seguridad y Servidor ---
API_KEY=
PORT=8081
LOG_LEVEL=INFO
