# Clave de API de Google Gemini (Obtén una gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo a utilizar. Modelos recomendados:
# - gemini-3.1-flash-lite (rápido, ligero y con mayor cuota RPD de solicitudes diarias)
# - gemini-3.5-flash (mayor rendimiento, menor cuota diaria)
GEMINI_MODEL=gemini-3.1-flash-lite

# Retardo proactivo en segundos entre llamadas (para evitar golpear límites del tier gratuito de 15 RPM)
# 4 segundos = max 15 RPM
DELAY_SECONDS=4
