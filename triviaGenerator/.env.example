# ============================================================
# trivia-api — Variables de entorno
# COPIAR este archivo como .env y completar los valores reales
# NUNCA subir .env al repositorio
# ============================================================

# --- Base de Datos PostgreSQL ---
# URL JDBC completa. En Podman, el host es el nombre del servicio (postgres)
DATABASE_URL=jdbc:postgresql://postgres:5432/triviadb
DATABASE_USERNAME=trivia_user
DATABASE_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# --- Inteligencia Artificial — Google Gemini ---
# Obtener en: https://aistudio.google.com/app/apikey
AI_API_KEY=OBTENER_EN_GOOGLE_AI_STUDIO
AI_MODEL=gemini-3.5-flash-lite
# Timeout en segundos para las llamadas al LLM
AI_TIMEOUT_SECONDS=120

# --- Parámetros de Generación ---
# Porcentaje de margen adicional al pedir trivias al LLM
# Ejemplo: 50 significa que si se piden 10, se solicitarán 15 al LLM
TRIVIA_GENERATION_BUFFER_PERCENTAGE=50
# Número máximo de intentos de generación antes de devolver error
MAX_GENERATION_ATTEMPTS=5

# --- Deduplicación Semántica (Fase 10) ---
# Threshold de similitud coseno (0.0 a 1.0)
# Valores cercanos a 1.0 = más estricto (menos falsos positivos)
# Valor recomendado: 0.90
TRIVIA_DUPLICATE_SIMILARITY_THRESHOLD=0.90

# --- Almacenamiento de Assets ---
# Ruta base donde se guardan los PNG generados
# En Podman, apunta al volumen montado
STORAGE_PATH=/data/storage
# URL pública base para construir las URLs de los assets
STORAGE_BASE_URL=http://localhost:8080/assets

# --- Auto-Exportación de Videos para Redes Sociales ---
# Si defines esta ruta (ej. tu carpeta de Google Drive), cada video generado se guardará
# automáticamente aquí con título dinámico y hashtags para Make.com / Shorts / Reels / TikTok.
TRIVIA_VIDEO_AUTO_EXPORT_PATH=G:/Mi unidad/Subir_Automatico

# --- Seguridad ---
# API Key que los clientes deben enviar en el header: X-API-Key
API_KEY=CAMBIAR_POR_API_KEY_SEGURA

# --- Servidor ---
PORT=8080

# --- Acceso Público Persistente (Ngrok - Dominio Fijo Gratuito) ---
NGROK_AUTHTOKEN=CAMBIAR_POR_TU_AUTHTOKEN_DE_NGROK
NGROK_DOMAIN=tu-dominio.ngrok-free.dev

# --- Acceso Público Opcional (Cloudflare Tunnel - profiles: [cloudflare]) ---
# Modo 1: Quick Tunnel 100% gratuito sin cuenta (trycloudflare.com)
CLOUDFLARE_TUNNEL_CMD=tunnel --no-autoupdate --url http://api:8080
# Modo 2: Túnel persistente con dominio propio (Cloudflare Zero Trust / Dashboard)
# CLOUDFLARE_TUNNEL_CMD=tunnel --no-autoupdate run --token TU_TUNNEL_TOKEN

# --- Logging ---
LOG_LEVEL=INFO
