# ============================================================
# trivia-api — Containerfile (Podman / Docker)
#
# Imagen ligera basada en Eclipse Temurin 21 (Alpine Linux)
# Incluye soporte nativo para AWT headless y fuentes TrueType
# Ejecuta bajo un usuario no-root por seguridad.
# ============================================================

FROM docker.io/eclipse-temurin:21-jre-alpine

LABEL maintainer="AlexVD1"
LABEL description="API REST de generación y almacenamiento de trivias con IA"

# Instalar fuentes TrueType y fontconfig para renderizado AWT Graphics2D en Alpine
RUN apk add --no-cache fontconfig ttf-dejavu

# Crear usuario y grupo sin privilegios
RUN addgroup -S trivia && adduser -S trivia -G trivia

# Directorios de la aplicación y almacenamiento persistente de imágenes
WORKDIR /app
RUN mkdir -p /data/storage && chown -R trivia:trivia /app /data/storage

# Copiar el ejecutable JAR
COPY target/trivia-api-0.0.1-SNAPSHOT.jar /app/app.jar
RUN chown trivia:trivia /app/app.jar

# Variables de entorno por defecto
ENV JAVA_OPTS="-Djava.awt.headless=true -Dfile.encoding=UTF-8 -XX:+UseG1GC -XX:MaxRAMPercentage=75.0"
ENV STORAGE_PATH="/data/storage"
ENV SERVER_PORT="8080"

# Cambiar a usuario no-root
USER trivia

EXPOSE 8080

# Healthcheck interno del contenedor
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
