<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.trivia</groupId>
    <artifactId>trivia-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>trivia-api</name>
    <description>Plataforma de Trivias con IA — Generación, Deduplicación y Almacenamiento</description>

    <properties>
        <java.version>21</java.version>
        <!-- springdoc 2.6.0 está en caché local y es compatible con Spring Boot 3.3.x -->
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencies>

        <!-- ====================================================
             WEB — API REST
             Spring MVC + Tomcat embebido + Jackson JSON
             ==================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ====================================================
             VALIDACIÓN — Bean Validation (Jakarta)
             Anotaciones como @NotBlank, @Min, @Max en DTOs
             ==================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ====================================================
             ACTUATOR — Health checks y métricas
             Expone /actuator/health usado internamente por Podman
             ==================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ====================================================
             PERSISTENCIA — Spring Data JPA + Hibernate
             Activado en Fase 3 cuando se levante PostgreSQL
             Por ahora la autoconfiguración está excluida en yml
             ==================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ====================================================
             BASE DE DATOS — PostgreSQL Driver
             scope runtime: solo necesario en ejecución, no en compilación
             ==================================================== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ====================================================
             MIGRACIONES — Flyway
             Gestiona la evolución del schema de base de datos.
             Alternativa descartada: Liquibase (más complejo, XML/YAML verboso)
             flyway-database-postgresql: módulo específico requerido desde Flyway 10
             ==================================================== -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ====================================================
             DOCUMENTACIÓN — OpenAPI 3 / Swagger UI
             Genera /swagger-ui.html y /v3/api-docs automáticamente
             springdoc es el sucesor de springfox (abandonado)
             ==================================================== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ====================================================
             TESTING
             JUnit 5 + Mockito + AssertJ + Spring Test
             ==================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Empaqueta la aplicación como un JAR ejecutable (fat jar) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
